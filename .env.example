# ============================================================================
# AI Providers — 作者默认 key（仅用于未配置 BYOK 的用户，受每日 quota 限制）
# 用户填写自己的 key 后走 BYOK，不会落库
# ============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=

# ============================================================================
# Vercel KV (Redis) — 用于 URL 摘要缓存 + 调用计数器
# 在 Vercel 项目 → Storage → KV → Create 后会自动注入
# ============================================================================
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ============================================================================
# Sentry (可选) — 生产错误监控
# 留空时 instrumentation.ts 直接 early-return 走 noop，不会有任何噪音
# ============================================================================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================================================
# 站点配置 — NEXT_PUBLIC_ 前缀的会暴露到前端 bundle
# ============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/ruanxinyang/ai-toolbox
